generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   // KAPRODI, ADMIN, DOSEN, MAHASISWA
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mahasiswa Mahasiswa?
  dosen     Dosen?
}

model Mahasiswa {
  id        String   @id @default(cuid())
  nim       String   @unique
  angkatan  String
  status    String   @default("AKTIF")
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique

  krs             KRS[]
  nilaiMahasiswa  NilaiMahasiswa[]
}

model Dosen {
  id        String   @id @default(cuid())
  nidn      String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique

  pengampu  Pengampu[]
}

model MataKuliah {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  nama_en   String?  // English name (optional)
  sks       Int
  semester  Int

  kelas     Kelas[]
  cpmk      CPMK[]
}

model Kelas {
  id            String   @id @default(cuid())
  nama          String
  tahun_ajaran  String
  semester      String
  mataKuliah    MataKuliah @relation(fields: [mkId], references: [id])
  mkId          String

  pengampu      Pengampu[]
  krs           KRS[]
  komponenNilai KomponenNilai[]
}

model Pengampu {
  id        String   @id @default(cuid())
  kelas     Kelas    @relation(fields: [kelasId], references: [id])
  kelasId   String
  dosen     Dosen    @relation(fields: [dosenId], references: [id])
  dosenId   String
}

model CPL {
  id             String   @id @default(cuid())
  kode           String   @unique
  deskripsi      String
  deskripsi_en   String?
  createdBy      String   @default("system")
  createdAt      DateTime @default(now())
  updatedBy      String?
  updatedAt      DateTime @updatedAt

  pi         PI[]
  bobotPiCpl BobotPI_CPL[]
}

model PI {
  id             String   @id @default(cuid())
  kode           String   @unique
  deskripsi      String
  cpl            CPL      @relation(fields: [cplId], references: [id])
  cplId          String
  createdBy      String   @default("system")
  createdAt      DateTime @default(now())
  updatedBy      String?
  updatedAt      DateTime @updatedAt

  cpmk        CPMK[]
  bobotCpmkPi BobotCPMK_PI[]
  bobotPiCpl  BobotPI_CPL[]
}

model CPMK {
  id             String   @id @default(cuid())
  kode           String
  deskripsi      String
  pi             PI       @relation(fields: [piId], references: [id])
  piId           String
  mataKuliah     MataKuliah @relation(fields: [mkId], references: [id])
  mkId           String
  createdBy      String   @default("system")
  createdAt      DateTime @default(now())
  updatedBy      String?
  updatedAt      DateTime @updatedAt

  bobotCpmk    BobotCPMK[]
  bobotCpmkPi  BobotCPMK_PI[]
}

model KomponenNilai {
  id        String   @id @default(cuid())
  nama      String   // UTS, UAS, Tugas
  bobot     Float    // Persentase e.g., 30, 40
  kelas     Kelas    @relation(fields: [kelasId], references: [id])
  kelasId   String

  bobotCpmk BobotCPMK[]
  nilaiMahasiswa NilaiMahasiswa[]
}

model BobotCPMK {
  id            String   @id @default(cuid())
  komponen      KomponenNilai @relation(fields: [komponenId], references: [id])
  komponenId    String
  cpmk          CPMK     @relation(fields: [cpmkId], references: [id])
  cpmkId        String
  bobot         Float    // Bobot komponen terhadap CPMK (total per CPMK = 100%)
}

// Bobot CPMK terhadap PI (total per PI = 100%)
model BobotCPMK_PI {
  id      String @id @default(cuid())
  cpmk    CPMK   @relation(fields: [cpmkId], references: [id])
  cpmkId  String
  pi      PI     @relation(fields: [piId], references: [id])
  piId    String
  bobot   Float  // Bobot CPMK terhadap PI (total semua CPMK dalam satu PI = 100%)
}

// Bobot PI terhadap CPL (total per CPL = 100%)
model BobotPI_CPL {
  id     String @id @default(cuid())
  pi     PI     @relation(fields: [piId], references: [id])
  piId   String
  cpl    CPL    @relation(fields: [cplId], references: [id])
  cplId  String
  bobot  Float  // Bobot PI terhadap CPL (total semua PI dalam satu CPL = 100%)
}

model NilaiMahasiswa {
  id            String   @id @default(cuid())
  mahasiswa     Mahasiswa @relation(fields: [mahasiswaId], references: [id])
  mahasiswaId   String
  komponen      KomponenNilai @relation(fields: [komponenId], references: [id])
  komponenId    String
  nilai         Float    // 0 - 100
  lastUpdatedBy String?  // User ID or name of dosen who last updated
  updatedAt     DateTime @default(now()) @updatedAt
}

model KRS {
  id            String   @id @default(cuid())
  mahasiswa     Mahasiswa @relation(fields: [mahasiswaId], references: [id])
  mahasiswaId   String
  kelas         Kelas    @relation(fields: [kelasId], references: [id])
  kelasId       String
}
